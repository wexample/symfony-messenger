{
  "name": "wexample/symfony-messenger",
  "description": "Entity messages carried as a pointer, and the queues that carry them",
  "version": "4.0.5",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyMessenger\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyMessenger\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "symfony/amqp-messenger": "^7.0",
    "symfony/messenger": "^7.0",
    "symfony/serializer": "^7.0",
    "wexample/symfony-helpers": ">=19.2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13",
    "symfony/property-access": "^7.0"
  },
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}